{
  "expo": {
    "name": "Aula+",
    "slug": "aulamas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "front",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "package": "com.lucass.aulamas",
      "adaptiveIcon": {
        "backgroundColor": "#050005",
        "foregroundImage": "./assets/images/logo-no-bg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo-no-bg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050005",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f2d61b3e-af19-4c6a-9fa9-b5f9d932f804"
      }
    },
    "owner": "lucas-07"
  }
}
